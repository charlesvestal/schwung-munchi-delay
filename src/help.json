{
  "title": "Munchi Delay",
  "children": [
    {
      "title": "Overview",
      "lines": [
        "CHOMPI TEMPO's",
        "Magic Wand effect:",
        "a clock-synced",
        "glitch delay.",
        "",
        "Wand: centre off.",
        "Down: a delay,",
        "1 bar near centre",
        "to 1/16 at the end.",
        "Up: same, melting",
        "into reverb."
      ]
    },
    {
      "title": "Knobs",
      "lines": [
        "Random: chance per",
        "1/8 of an octave,",
        "reverse or pan",
        "jump.",
        "Feedback: past 60%",
        "new sound ducks it.",
        "Mix: dry to wet.",
        "Freeze: loop the",
        "buffer (Wand on).",
        "Clock: 1/2x-2x."
      ]
    }
  ]
}
